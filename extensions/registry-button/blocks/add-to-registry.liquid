{% comment %}
  "Add to registry" — app block for the product template.

  The merchant drags this into their product page in the theme editor. Because
  it is part of the theme's own section tree, a theme update cannot remove it,
  and the merchant can move or restyle it without a support ticket.

  Everything here is server-rendered Liquid plus one small vanilla script. No
  framework on a storefront that isn't ours to slow down.
{% endcomment %}

{%- comment -%}Before 7 Nov 2026 these settings had English defaults, which themes saved with each block. A label still equal to its old default is treated as blank so it follows the shopper's language.{%- endcomment -%}
{%- assign lbl_button_label = block.settings.button_label -%}{%- if lbl_button_label == blank or lbl_button_label == 'Add to registry' -%}{%- assign lbl_button_label = 'add_to_registry.label' | t -%}{%- assign lbl_button_default = ' data-gp-t="add_to_registry.label"' -%}{%- endif -%}

{%- assign gp_sf = request.locale.iso_code | slice: 0, 2 -%}{%- assign gp_lang = '' -%}{%- if gp_sf == 'en' -%}{%- assign gp_lang = app.metafields.giftpin.language.value | default: '' -%}{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign offers_choice = false -%}
{%- if block.settings.offer_babylist or block.settings.offer_other_registry -%}
  {%- assign offers_choice = true -%}
{%- endif -%}

<div
  class="giftpin-block"
  data-giftpin-root
  data-product-id="{{ product.id }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}"
  data-price="{{ current_variant.price | divided_by: 100.0 }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-proxy="{{ block.settings.proxy_path | default: '/apps/registry' }}"
  data-label-adding="{{ 'add_to_registry.adding' | t | escape }}"
  data-label-added="{{ 'add_to_registry.added' | t | escape }}"
  data-label-added-short="{{ 'add_to_registry.added_short' | t | escape }}"
  data-label-error="{{ 'add_to_registry.error' | t | escape }}"
  data-label-back="{{ 'add_to_registry.back' | t | escape }}"
  data-label-updating="{{ 'add_to_registry.updating' | t | escape }}"
  data-label-updated="{{ 'add_to_registry.updated' | t | escape }}"
  data-label-update-error="{{ 'add_to_registry.update_error' | t | escape }}"
  data-label-dup-message="{{ 'add_to_registry.dup_message' | t: qty: '__QTY__' | escape }}"
  data-label-dup-short="{{ 'add_to_registry.dup_short' | t: qty: '__QTY__' | escape }}"
  data-label-copy-prompt="{{ 'add_to_registry.copy_prompt' | t | escape }}"
  data-gp-lang="{{ gp_lang | escape }}"
  data-lang="{% if gp_lang != blank %}{{ gp_lang | escape }}{% else %}{{ request.locale.iso_code | escape }}{% endif %}"
  data-shop-name="{{ shop.name | escape }}"
  data-customer-id="{{ customer.id }}"
  {%- if offers_choice %}
    data-offers-choice="1"
  {%- endif %}
  {%- if block.settings.offer_babylist %}
    data-babylist-partner="{{ shop.domain | escape }}"
    data-label-babylist-error="{{ 'add_to_registry.babylist_error' | t | escape }}"
  {%- endif %}
  {%- if block.settings.offer_other_registry %}
    data-label-link-copied="{{ 'add_to_registry.link_copied' | t | escape }}"
  {%- endif %}
  {{ block.shopify_attributes }}
  style="
    --giftpin-accent: {{ block.settings.accent_color }};
    --giftpin-radius: {{ block.settings.corner_radius }}px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  "
>
  <button type="button" class="giftpin-btn" data-giftpin-open>
    {%- if block.settings.show_icon -%}
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 3.5c1.2-1.6 4-1.4 5 .4.9 1.6.1 3.4-1.3 4.6L10 12 6.3 8.5C4.9 7.3 4.1 5.5 5 3.9c1-1.8 3.8-2 5-.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M3.5 12.5h13v4h-13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    {%- endif -%}
    <span data-giftpin-label{{ lbl_button_default }}>{{ lbl_button_label }}</span>
  </button>

  <p class="giftpin-deal" data-giftpin-deal hidden></p>

  <p class="giftpin-status" data-giftpin-status role="status" aria-live="polite"></p>

  {%- if offers_choice -%}
    {%- comment -%}
      "Add to any registry": shoppers whose registry lives elsewhere can still
      use this store's button. Each option is a merchant toggle, off by
      default. To add another registry later, add a toggle in the schema, a
      button here and a handler in CHOICES in giftpin.js. Names are plain
      text, never logos: Giftpin has no partnership with these sites, and
      purchases made from their registries aren't tracked by Giftpin.

      Babylist: its own retailer script
      (babylist.com/add-to-babylist-integration) does the adding, and loads
      only once a shopper picks Babylist.
    {%- endcomment -%}
    <div class="giftpin-picker giftpin-choice" data-giftpin-choice hidden>
      <p class="giftpin-label" data-gp-t="add_to_registry.which">{{ 'add_to_registry.which' | t }}</p>
      <div class="giftpin-row">
        <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-option="store" data-gp-t="add_to_registry.store_option">
          {{ 'add_to_registry.store_option' | t: shop: shop.name }}
        </button>
        {%- if block.settings.offer_babylist -%}
          <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-option="babylist" data-gp-t="add_to_registry.babylist_option">
            {{ 'add_to_registry.babylist_option' | t }}
          </button>
        {%- endif -%}
        {%- if block.settings.offer_other_registry -%}
          {%- comment -%}
            Zola and most other registries have no retailer button, only their
            own app or browser button that takes a product link, so this copies
            the link and says where to paste it. No deep links: none of them
            document one.
          {%- endcomment -%}
          <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-option="other" data-gp-t="add_to_registry.other_option">
            {{ 'add_to_registry.other_option' | t }}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- if block.settings.offer_babylist -%}
    {%- comment -%}
      Per-variant details for Babylist, so the item it saves matches the
      variant the shopper has selected (Babylist's own Shopify example needs
      theme code for this; reading it here avoids that).
    {%- endcomment -%}
    <script type="application/json" data-giftpin-babylist-product>
      {
        "url": {{ shop.url | append: product.url | json }},
        "title": {{ product.title | json }},
        "vendor": {{ product.vendor | json }},
        "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "title": {% if product.has_only_default_variant %}null{% else %}{{ variant.title | json }}{% endif %},
              "price": {{ variant.price | json }},
              "sku": {{ variant.sku | json }},
              "barcode": {{ variant.barcode | json }},
              "available": {{ variant.available | json }},
              "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}

  {%- comment -%}
    The picker only appears once a customer has more than one registry, so the
    common case stays a single tap. Hidden until needed; never a modal on load.
  {%- endcomment -%}
  <div class="giftpin-picker" data-giftpin-picker hidden>
    <label class="giftpin-label" data-gp-t="add_to_registry.choose" for="giftpin-select-{{ block.id }}">
      {{ 'add_to_registry.choose' | t }}
    </label>
    <select class="giftpin-select" id="giftpin-select-{{ block.id }}" data-giftpin-select></select>
    <div class="giftpin-row">
      <input
        class="giftpin-qty"
        type="number"
        min="1"
        max="20"
        value="1"
        data-giftpin-qty
        data-gp-aria="add_to_registry.quantity"
        aria-label="{{ 'add_to_registry.quantity' | t | escape }}"
      >
      <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-confirm{{ lbl_button_default }}>
        {{ lbl_button_label }}
      </button>
    </div>
  </div>

  {%- comment -%}
    Shown when this item is already on the registry. Silently bumping the
    quantity on a second click hides a real decision (the event host wants
    two of these) behind the same action as an accidental double-add — so we
    ask instead, and let them set the exact total they want.
  {%- endcomment -%}
  <div class="giftpin-picker" data-giftpin-dup hidden>
    <p class="giftpin-label" data-giftpin-dup-message></p>
    <div class="giftpin-row">
      <input
        class="giftpin-qty"
        type="number"
        min="1"
        max="99"
        data-giftpin-dup-qty
        data-gp-aria="add_to_registry.total_quantity"
        aria-label="{{ 'add_to_registry.total_quantity' | t | escape }}"
      >
      <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-dup-confirm data-gp-t="add_to_registry.update">
        {{ 'add_to_registry.update' | t }}
      </button>
      <button type="button" class="giftpin-btn giftpin-btn--sm" data-giftpin-dup-cancel data-gp-t="add_to_registry.cancel">
        {{ 'add_to_registry.cancel' | t }}
      </button>
    </div>
  </div>
</div>

{{ 'giftpin.css' | asset_url | stylesheet_tag }}
<script src="{{ 'giftpin-i18n.js' | asset_url }}" defer></script>
{%- if block.settings.offer_babylist -%}
  <script src="{{ 'giftpin-babylist.js' | asset_url }}" defer></script>
{%- endif %}
<script src="{{ 'giftpin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Add to registry",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "giftpin.css",
  "javascript": "giftpin.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to show “Add to registry” in the language your shopper is browsing in."
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show gift icon",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Space above",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "offer_babylist",
      "label": "Also offer Babylist",
      "default": false,
      "info": "Shoppers can choose your registry or their Babylist registry. Babylist's add script loads only when a shopper picks it. Purchases from Babylist registries aren't tracked by Giftpin."
    },
    {
      "type": "checkbox",
      "id": "offer_other_registry",
      "label": "Also offer \"Another registry\"",
      "default": false,
      "info": "Copies the product link and tells shoppers to paste it into their registry's own app or browser button (for example Zola's). Purchases from other registries aren't tracked by Giftpin."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Registry URL path",
      "default": "/apps/registry",
      "info": "Only change this if you renamed the app's URL in Settings → Apps."
    }
  ]
}
{% endschema %}
