{% comment %}
  "Saved items" — app block listing what this shopper hearted with the
  "Save for later" block. Put it on a page, the cart page or the homepage.
  The list lives in the shopper's browser, so it is empty on a new device.
{% endcomment %}

{%- comment -%}Before 7 Nov 2026 these settings had English defaults, which themes saved with each block. A label still equal to its old default is treated as blank so it follows the shopper's language.{%- endcomment -%}
{%- assign lbl_heading = block.settings.heading -%}{%- if lbl_heading == blank or lbl_heading == 'Saved for later' -%}{%- assign lbl_heading = 'save_for_later.heading' | t -%}{%- assign lbl_heading_default = ' data-gp-t="save_for_later.heading"' -%}{%- endif -%}
{%- assign lbl_empty_text = block.settings.empty_text -%}{%- if lbl_empty_text == blank or lbl_empty_text == 'Nothing saved yet. Tap the heart on a product to keep it here.' -%}{%- assign lbl_empty_text = 'save_for_later.empty' | t -%}{%- assign lbl_empty_default = ' data-gp-t="save_for_later.empty"' -%}{%- endif -%}

{%- assign gp_sf = request.locale.iso_code | slice: 0, 2 -%}{%- assign gp_lang = '' -%}{%- if gp_sf == 'en' -%}{%- assign gp_lang = app.metafields.giftpin.language.value | default: '' -%}{%- endif -%}

<section
  class="giftpin-saved"
  data-giftpin-saved-root
  data-product-base="{{ routes.root_url | append: 'products/' }}"
  data-gp-lang="{{ gp_lang | escape }}"
  data-label-add="{{ 'save_for_later.add_to_registry' | t | escape }}"
  data-label-remove="{{ 'save_for_later.remove' | t | escape }}"
  {{ block.shopify_attributes }}
>
  <h2 class="giftpin-saved__heading"{{ lbl_heading_default }}>{{ lbl_heading | escape }}</h2>
  <p class="giftpin-saved__empty" data-giftpin-saved-empty{{ lbl_empty_default }}>{{ lbl_empty_text | escape }}</p>
  <ul class="giftpin-saved__list" data-giftpin-saved-list></ul>
</section>

{{ 'giftpin-saved.css' | asset_url | stylesheet_tag }}
<script src="{{ 'giftpin-i18n.js' | asset_url }}" defer></script>
<script src="{{ 'giftpin-saved.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Saved items",
  "target": "section",
  "stylesheet": "giftpin-saved.css",
  "javascript": "giftpin-saved.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the shopper's language." },
    {
      "type": "text", "id": "empty_text", "label": "Text when nothing is saved",
      "info": "Leave blank to use the shopper's language."
    }
  ]
}
{% endschema %}
