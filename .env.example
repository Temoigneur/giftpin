# Copy to .env. `shopify app dev` injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET /
# SHOPIFY_APP_URL / SCOPES for you, so you only need the rest.

# --- required ---------------------------------------------------------------

DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts access tokens, registrant emails and shipping addresses at rest.
# Rotating this without re-encrypting will orphan every encrypted field.
ENCRYPTION_KEY=""

# 32 bytes, base64, generated the same way. Signs cart attribution tokens,
# magic links and image-proxy URLs. Distinct from ENCRYPTION_KEY on purpose:
# a signing key leak is recoverable, an encryption key leak is not.
SIGNING_KEY=""

# --- optional: falls back to an in-process driver when unset -----------------

# Cache + job queue. Without it the app uses an in-memory LRU and runs jobs
# inline — fine for local dev and a single instance, NOT for production with
# more than one process.
REDIS_URL=""

# Transactional email. Without it, mail is logged to stdout.
RESEND_API_KEY=""
MAIL_FROM="Giftpin <registry@yourdomain.com>"

# --- optional: tuning --------------------------------------------------------

# Hours a guest's soft claim on an external item is held before it is released.
CLAIM_HOLD_HOURS="48"

# Sent as the User-Agent when fetching a registrant-pasted product URL.
# Keep a reachable contact URL in it — it is how a retailer asks you to stop.
RESOLVER_USER_AGENT="GiftpinBot/1.0 (+https://yourdomain.com/bot)"

# Comma-separated hostnames the resolver will never fetch.
RESOLVER_DENYLIST=""

# Affiliate-network redirect endpoint for external-store outbound links (see
# app/lib/affiliate.ts) — 20 Sep 2026 disclosed-commission decision. Leave
# unset until you've actually signed up with a network (Sovrn Commerce,
# Skimlinks, Walmart Creator, ...); every outbound link is left unmodified
# until this is set. Set to that network's redirect endpoint up to and
# including the query param that takes the destination URL, e.g.:
#   AFFILIATE_LINK_WRAPPER_BASE="https://redirect.example-network.com/?key=yourPubId&u="
AFFILIATE_LINK_WRAPPER_BASE=""

# Pro plan billing (app/routes/app.billing.tsx). Leave unset/"true" until the
# app is actually live — that runs every charge in Shopify's test mode, so no
# card is ever really billed even if a merchant clicks Upgrade. Set to
# "false" deliberately at the same time as the other go-live switches (see
# STATUS.md) — not before, or a real merchant could get a real charge from a
# dev deploy.
BILLING_TEST_MODE="true"

NODE_ENV="development"
