// Registro — gift registry for Shopify
// Data model per architecture-decisions.md §5.5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage (required by @shopify/shopify-app-session-storage-prisma)
// ---------------------------------------------------------------------------

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Shop
// ---------------------------------------------------------------------------

enum ShopPlan {
  free
  pro
}

model Shop {
  id          String   @id @default(cuid())
  domain      String   @unique // foo.myshopify.com
  name        String?
  currency    String   @default("USD")
  moneyFormat String?
  installedAt DateTime @default(now())
  uninstalledAt DateTime?

  // Merchant-configurable behaviour. See SHOP_SETTINGS_DEFAULTS in app/models/shop.server.ts
  settings Json @default("{}")

  // Billing (added 22 Sep 2026 — see app/routes/app.billing.tsx). `plan` is a
  // cache of Shopify's own billing state, kept in sync by the
  // APP_SUBSCRIPTIONS_UPDATE webhook (app/routes/webhooks.app_subscriptions.update.tsx).
  // It exists so guest-facing proxy pages (no admin session, can't call the
  // Billing API) can gate Pro features with a plain column read.
  plan            ShopPlan  @default(free)
  shopifyChargeId String? // gid://shopify/AppSubscription/123 of the active subscription, if any
  planUpdatedAt   DateTime?

  registries Registry[]

  @@index([uninstalledAt])
}

// ---------------------------------------------------------------------------
// Registry
// ---------------------------------------------------------------------------

enum RegistryPrivacy {
  unlisted // default: unguessable slug, noindex, not in find-a-registry
  public_ // listed in find-a-registry, still noindex on the item page
  password
}

enum RegistryStatus {
  active
  archived
  deleted
}

model Registry {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Shopify customer ID if the registrant was logged in. Registries do NOT
  // require a customer account — magic-link tokens carry the session instead,
  // because app proxy strips cookies (see app/lib/proxy.server.ts).
  customerId String?

  slug      String
  eventType String // wedding | baby | birthday | housewarming | graduation | corporate | other
  eventDate DateTime?
  title     String
  message   String?

  coverImageUrl String?

  // Country whose stores we link to when the hosting store lacks an item
  // (US | CA | GB | AU). Null = the default, US.
  country String?

  privacy      RegistryPrivacy @default(unlisted)
  indexable    Boolean         @default(false) // opt-in; see §8 privacy
  passwordHash String?

  shipToRegistrant Boolean @default(false)
  // Chip-in gift cards are emailed straight to the owner registrant. Off by
  // default because it puts their email into the guest's cart, where the
  // guest can see it. Off: the card goes to the guest to pass on. SPIKE-C.md.
  contributionsToRegistrant Boolean @default(false)
  // AES-256-GCM ciphertext of a JSON address. Never rendered on a public page.
  shippingAddressEnc String?

  status    RegistryStatus @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Bumped on every write; forms part of the cache key so a purchase
  // invalidates the rendered page instantly. See app/lib/cache.server.ts
  version Int @default(1)

  registrants Registrant[]
  items       RegistryItem[]
  events      RegistryEvent[]

  guestReminders GuestReminder[]

  @@unique([shopId, slug])
  @@index([shopId, status])
  @@index([shopId, eventDate])
}

enum RegistrantRole {
  owner
  co
}

model Registrant {
  id         String   @id @default(cuid())
  registryId String
  registry   Registry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  name     String
  emailEnc String // AES-256-GCM
  // Deterministic HMAC of the lowercased email, so we can look up without decrypting.
  emailHash String
  role     RegistrantRole @default(owner)

  createdAt DateTime @default(now())

  @@index([registryId])
  @@index([emailHash])
}

// A guest who asked, on the registry page, to be emailed before the event
// (Pro: app/models/automations.server.ts). Opt-in only, one row per email per
// registry, and deleted by the retention job once the event has passed.
model GuestReminder {
  id         String   @id @default(cuid())
  registryId String
  registry   Registry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  emailEnc  String // AES-256-GCM
  emailHash String // blindIndex(), for dedup and customers/redact

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([registryId, emailHash])
  @@index([emailHash])
}

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

enum ItemSourceType {
  internal      // merchant's own catalog — buyable, attributable
  shopify_ext   // another Shopify store — live price/stock, not buyable here
  web           // resolved from page metadata — snapshot only
  manual        // registrant typed it
  fund          // cash fund (e.g. honeymoon): no product, guests chip in with store gift cards. See SPIKE-C.md
}

model RegistryItem {
  id         String   @id @default(cuid())
  registryId String
  registry   Registry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  sourceType ItemSourceType

  // internal items only
  productGid String? // gid://shopify/Product/123
  variantGid String? // gid://shopify/ProductVariant/456

  // everything else
  externalSourceId String?
  externalSource   ExternalSource? @relation(fields: [externalSourceId], references: [id])

  // Denormalized copy of whatever this item looked like when it was added.
  //
  // The guest page MUST render from the database alone — no Storefront API
  // call per item, no waiting on a third-party fetch. For internal items this
  // is refreshed from the merchant's catalog; for manual items it is what the
  // registrant typed; for external items ExternalSource wins and this is the
  // fallback while the resolver job is still in flight.
  snapshotTitle    String?
  snapshotImageUrl String?
  snapshotPrice    Decimal? @db.Decimal(12, 2)
  snapshotCurrency String?
  /** Storefront URL for external and manual items. */
  externalUrl      String?

  desiredQty   Int @default(1)
  purchasedQty Int @default(0)

  /// Group gifting / cash funds (Pro, see SPIKE-C.md). Non-null means guests
  /// can chip in toward this item with a store gift card; the item counts as
  /// taken once fundedAmount reaches it. Always set on `fund` items.
  fundGoal     Decimal? @db.Decimal(12, 2)
  /// Running total of non-voided contribution Purchases, in shop currency.
  /// Kept in step with them inside the same transaction, like purchasedQty.
  fundedAmount Decimal  @default(0) @db.Decimal(12, 2)

  priority Int     @default(0) // higher sorts first
  note     String?

  /// "In this store" suggestion for outside items. See app/lib/store-match.server.ts.
  /// storeMatchStatus: null | none | suggested | kept | dismissed
  storeMatchStatus     String?
  storeMatchProductGid String?
  storeMatchVariantGid String?
  storeMatchTitle      String?
  storeMatchHandle     String?

  /// Gift category key (see app/shared/gift-categories.ts). Null = uncategorised.
  category String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims    Claim[]
  purchases Purchase[]

  @@index([registryId, priority])
  @@index([externalSourceId])
  // Closes the addInternalItem/addExternalItem race documented in CLAUDE.md
  // and STATUS.md (19 Sep 2026): two near-simultaneous adds could both pass
  // the findFirst dedup check before either write landed. Nullable fields are
  // safe here — Postgres treats every NULL as distinct, so external/manual
  // items (no variantGid) and internal items (no externalUrl) never collide
  // with each other or with other NULLs of the same kind.
  @@unique([registryId, variantGid])
  @@unique([registryId, externalUrl])
}

// Deduplicated across ALL shops — this is public product data, never customer
// data, so one row serves every registry that references the same URL.
model ExternalSource {
  id String @id @default(cuid())

  canonicalUrlHash String @unique // sha256 of canonicalUrl
  canonicalUrl     String
  domain           String
  resolver         String // shopify_public | jsonld | microdata | opengraph | oembed | manual

  title    String?
  imageUrl String? // remote URL; always served to guests through /proxy/img
  price    Decimal? @db.Decimal(12, 2)
  currency String?
  availability String? // in_stock | out_of_stock | unknown

  lastFetchedAt DateTime?
  fetchStatus   String    @default("pending") // pending | ok | failed | blocked | gone
  fetchError    String?
  // How long the cached copy is considered fresh, in seconds.
  ttlSeconds    Int       @default(604800)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RegistryItem[]

  @@index([domain])
  @@index([fetchStatus, lastFetchedAt])
}

// ---------------------------------------------------------------------------
// Claims — soft holds, EXTERNAL ITEMS ONLY.
//
// Internal items need no reservation: the orders/create webhook is ground
// truth. External items need one because nothing will ever tell us.
// ---------------------------------------------------------------------------

model Claim {
  id     String       @id @default(cuid())
  itemId String
  item   RegistryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  qty Int @default(1)

  // Opaque, non-identifying: HMAC(ip + user-agent + item). Lets a returning
  // guest release their own claim without us storing anything about them.
  guestFingerprint String

  expiresAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())

  @@index([itemId, releasedAt])
  @@index([expiresAt, releasedAt])
}

// ---------------------------------------------------------------------------
// Purchases
// ---------------------------------------------------------------------------

enum PurchaseSource {
  online   // attributed from an order webhook
  pos      // V2
  manual   // registrant marked it purchased
  external // guest confirmed they bought it elsewhere
}

model Purchase {
  id     String       @id @default(cuid())
  itemId String
  item   RegistryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  source PurchaseSource

  orderId    String? // gid://shopify/Order/123
  lineItemId String? // gid://shopify/LineItem/456
  orderName  String? // #1024, for the merchant dashboard

  qty Int @default(1)

  // Value captured for the ROI dashboard, in shop currency.
  amount   Decimal? @db.Decimal(12, 2)
  currency String?

  buyerName    String?
  buyerEmailEnc String?
  buyerMessage String?
  // Shopify customer id of the buyer (numeric, as a string). Kept only so
  // customers/redact can erase this buyer's name; cleared with the name.
  buyerCustomerId String?

  // Registrant doesn't see who gave what until after this moment.
  hiddenUntil DateTime?

  shippedToRegistrant Boolean @default(false)
  // A gift card bought as a chip-in toward a group gift or fund (SPIKE-C.md).
  // `amount` is what counts; `qty` is the number of cards and never touches
  // RegistryItem.purchasedQty.
  isContribution Boolean @default(false)
  // True when this order contained a customer who had never bought from the
  // shop before — feeds "new customers acquired" on the dashboard.
  isNewCustomer Boolean @default(false)

  voidedAt DateTime? // refund or cancellation; keeps the row for audit
  createdAt DateTime @default(now())

  // Webhook idempotency. A null orderId (manual/external) never collides
  // because Postgres treats NULLs as distinct in a unique index.
  @@unique([orderId, lineItemId])
  @@index([itemId, voidedAt])
  @@index([buyerCustomerId])
}

// ---------------------------------------------------------------------------
// Event log — audit trail, and the source of truth for the ROI dashboard
// ---------------------------------------------------------------------------

model RegistryEvent {
  id         String   @id @default(cuid())
  registryId String
  registry   Registry @relation(fields: [registryId], references: [id], onDelete: Cascade)

  type    String // created | item_added | item_removed | shared | claimed | purchased | refunded | ...
  payload Json   @default("{}")

  createdAt DateTime @default(now())

  @@index([registryId, createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Processed webhooks — belt-and-braces idempotency for topics where the
// unique index above isn't enough (refunds, cancellations).
// ---------------------------------------------------------------------------

model ProcessedWebhook {
  id        String   @id // X-Shopify-Webhook-Id
  topic     String
  shop      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit log — who/what touched personal data. No relations on purpose: it must
// outlive the registry or shop it describes. Pruned after 12 months.
// ---------------------------------------------------------------------------

model AuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  shop    String?
  actor   String
  action  String
  subject String?
  detail  Json     @default("{}")

  @@index([at])
  @@index([shop, at])
}
