{% comment %}
  "Registry links" — app block for a header, footer or homepage section.

  Gives shoppers a way to start, find and manage a gift registry from
  anywhere on the store. Plain links and a scoped inline style: no stylesheet
  request, nothing to slow the storefront down. The one script runs only on
  the cart page (below).

  Cart page "Return to registry" (2 Nov 2026, Ben: an emptied cart said "Your
  cart is empty" with no way back). The guest page saves the last registry a
  guest opened in localStorage as giftpin_last ({u: path, t: title}); the
  storefront is the same origin as the app proxy page, so this block can read
  it. The link goes under the cart heading, and again under the empty-cart
  message, wherever the theme is showing that one. Themes re-render
  the cart after a removal, so it re-adds itself when that wipes it. Placement
  is written against Dawn's markup (.title-wrapper-with-link,
  .cart__empty-text) with a fallback to the top of <main>; not yet checked on
  a live theme.

  Defaults are deliberately prominent (buttons, 18px, centred) and the link
  text says "gift registry" in full: "registry" alone is easy to miss or
  misread for shoppers who don't read English as a first language.
{% endcomment %}

{%- assign base = block.settings.proxy_path | default: '/apps/registry' -%}
{%- assign size = block.settings.text_size | default: 18 -%}

<nav
  class="giftpin-links giftpin-links--{{ block.id }} giftpin-links--{{ block.settings.style | default: 'buttons' }}"
  aria-label="{{ block.settings.heading | default: 'Gift registry' | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="giftpin-links__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  <ul class="giftpin-links__list">
    <li><a href="{{ base }}">{{ block.settings.create_label | default: 'Create a gift registry' | escape }}</a></li>
    {%- if block.settings.show_find -%}
      <li><a href="{{ base }}/find">{{ block.settings.find_label | default: 'Find a gift registry' | escape }}</a></li>
    {%- endif -%}
    {%- if block.settings.show_manage -%}
      <li><a href="{{ base }}/manage">{{ block.settings.manage_label | default: 'Manage my gift registry' | escape }}</a></li>
    {%- endif -%}
  </ul>
</nav>

{%- if template.name == 'cart' and block.settings.show_cart_return -%}
<script>
  (function () {
    var r;
    try { r = JSON.parse(localStorage.getItem('giftpin_last') || 'null'); } catch (e) {}
    if (!r || typeof r.u !== 'string' || r.u.indexOf({{ base | append: '/' | json }}) !== 0) return;
    var text = {{ block.settings.cart_return_label | default: 'Return to registry' | json }};
    function link() {
      var p = document.createElement('p');
      p.className = 'giftpin-return';
      p.style.margin = '0.6em 0 1em';
      var a = document.createElement('a');
      a.href = r.u;
      a.textContent = text + (r.t ? ': ' + r.t : '');
      a.style.textDecoration = 'underline';
      a.style.textUnderlineOffset = '3px';
      p.appendChild(a);
      return p;
    }
    function place() {
      var spots = document.querySelectorAll('.title-wrapper-with-link, .cart__empty-text');
      if (!spots.length) {
        var main = document.querySelector('main');
        if (main && !main.querySelector('.giftpin-return')) main.insertBefore(link(), main.firstChild);
        return;
      }
      Array.prototype.forEach.call(spots, function (el) {
        var next = el.nextElementSibling;
        var has = next && next.classList.contains('giftpin-return');
        var shown = el.offsetParent !== null;
        if (shown && !has) el.parentNode.insertBefore(link(), next);
        if (!shown && has) next.remove();
      });
    }
    function start() {
      place();
      new MutationObserver(function () { place(); }).observe(document.querySelector('main') || document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'hidden', 'style'] });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
</script>
{%- endif -%}

<style>
  .giftpin-links--{{ block.id }} {
    margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px;
    padding: 0 16px;
    max-width: 1200px;
    font-size: {{ size }}px;
    line-height: 1.4;
    text-align: {{ block.settings.alignment | default: 'center' }};
  }
  .giftpin-links--{{ block.id }} .giftpin-links__heading { margin: 0 0 0.6em; font-weight: 600; font-size: 2em; }
  .giftpin-links--{{ block.id }} .giftpin-links__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px 16px;
    justify-content: {% case block.settings.alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    {% if block.settings.layout == 'stacked' %}flex-direction: column; align-items: {% case block.settings.alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};{% endif %}
  }
  .giftpin-links--{{ block.id }}.giftpin-links--links a {
    color: {{ block.settings.link_color }}; text-decoration: underline; text-underline-offset: 3px;
  }
  .giftpin-links--{{ block.id }}.giftpin-links--buttons a {
    display: inline-block; padding: 0.6em 1.2em; border-radius: 4px;
    border: 1px solid {{ block.settings.link_color }}; color: {{ block.settings.link_color }};
    text-decoration: none;
  }
  .giftpin-links--{{ block.id }}.giftpin-links--buttons li:first-child a {
    background: {{ block.settings.link_color }}; color: {{ block.settings.button_text_color }};
  }
  .giftpin-links--{{ block.id }} a:focus-visible { outline: 2px solid {{ block.settings.link_color }}; outline-offset: 3px; }
</style>

{% schema %}
{
  "name": "Registry links",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift registry" },
    { "type": "text", "id": "create_label", "label": "Create link text", "default": "Create a gift registry" },
    { "type": "checkbox", "id": "show_find", "label": "Show the find-a-registry link", "default": true, "info": "Uses “Enable the public find-a-registry page” in Giftpin → Settings → Privacy (on by default). If a store turns it off, the link tells guests to ask for the registry link." },
    { "type": "text", "id": "find_label", "label": "Find link text", "default": "Find a gift registry" },
    { "type": "checkbox", "id": "show_manage", "label": "Show the manage-my-registry link", "default": true },
    { "type": "text", "id": "manage_label", "label": "Manage link text", "default": "Manage my gift registry" },
    { "type": "checkbox", "id": "show_cart_return", "label": "Show “Return to registry” on the cart page", "default": true, "info": "Links back to the last registry the shopper opened on this device." },
    { "type": "text", "id": "cart_return_label", "label": "Return link text", "default": "Return to registry" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "buttons", "label": "Buttons" },
        { "value": "links", "label": "Text links" }
      ],
      "default": "buttons"
    },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "inline", "label": "In a row" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "inline"
    },
    { "type": "color", "id": "link_color", "label": "Link and button colour", "default": "#1a1a1a" },
    { "type": "color", "id": "button_text_color", "label": "Main button text colour", "default": "#ffffff" },
    { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "margin_bottom", "label": "Space below", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 24 },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Registry URL path",
      "default": "/apps/registry",
      "info": "Only change this if you renamed the app's URL in Settings → Apps."
    }
  ]
}
{% endschema %}
